<mjml>
  <mj-head>
    <mj-title>Corporate Update | Gara Group</mj-title>
    <mj-preview>
      Discover the latest updates and announcements from Gara Group
    </mj-preview>
    <mj-font name="Montserrat" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&display=swap" />
    <mj-attributes>
      <mj-all font-family="Montserrat, Arial, sans-serif" />
      <mj-text font-size="14px" color="#333333" line-height="1.6" />
      <mj-button background-color="#000000" color="#ffffff" font-weight="600" border-radius="4px" inner-padding="12px 24px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f2f2f2">
    <mj-section background-color="#65B2E8" padding="20px">
      <mj-column>
        <mj-text align="center" color="#ffffff" font-size="22px" font-weight="700" letter-spacing="0.5px" padding-bottom="6px">
          Corporate Update
        </mj-text>
        <mj-text align="center" color="#ffffff" font-size="16px" font-weight="700" letter-spacing="0.5px" padding-bottom="4px">
          This Weeks update and events.
        </mj-text>
        <mj-text align="center" color="#ffffff" font-size="13px" font-weight="700" letter-spacing="0.5px">
          This Weeks update and events.
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="14px 20px">
      <mj-column width="72px" vertical-align="middle">
        <mj-image src="https://res.cloudinary.com/dem8z9lgk/image/upload/v1770166505/ChatGPT_Image_3_feb_2026_17_54_47_wecgkw.png" alt="Alan Peraza" width="64px" height="64px" padding="0" style="border-radius:50%;" />
      </mj-column>
      <mj-column vertical-align="middle">
        <mj-text align="left" font-size="13px" font-weight="600" line-height="1.5" padding="0 0 2px 10px">
          <span style="color:#65B2E8; font-size:18px; font-weight:700;">“</span>
          <span style="color:#6B7280;">
            Ready to begin. The next chapter starts now
          </span>
          <span style="color:#65B2E8; font-size:18px; font-weight:700;">”</span>
        </mj-text>
        <mj-text align="left" color="#6B7280" font-size="11px" font-weight="500" padding="0 0 0 10px">
          — Alan Peraza
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="32px 24px">
      <mj-column>
        <mj-text font-size="20px" font-weight="700" padding-bottom="12px">
          Hello <strong>Gara Group</strong>
        </mj-text>
        <mj-text font-size="16px">
          I'm pleased to announce you that I have completed the exercise successfully.
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="0 24px 32px">
      <mj-column vertical-align="middle">
        <mj-button href="https://wa.me/5216222274633?text=Hi%20Alan%2C%20we%E2%80%99d%20love%20to%20have%20you%20join%20our%20team" background-color="#002D74" color="#ffffff" font-weight="700" border-radius="6px" inner-padding="14px 26px">
          Send Message 💬
        </mj-button>
      </mj-column>
      <mj-column width="150px" vertical-align="middle">
        <mj-image src="https://res.cloudinary.com/dem8z9lgk/image/upload/v1770165308/Macbook_Laptop_Mockup_tdenqa.jpg" alt="Gara Group" width="150px" padding="0" />
      </mj-column>
    </mj-section>
    <mj-section background-color="#65B2E8" padding="16px">
      <mj-column>
        <mj-text color="#ffffff" font-size="12px" align="center">
          © Alan Peraza Second Excercise · All rights reserved
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>