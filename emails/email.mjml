<mjml>
  <mj-head>
    <mj-title>Store Update | Gara Group</mj-title>
    <mj-preview>
      Discover the latest updates and new arrivals from our store
    </mj-preview>
    <mj-font name="Montserrat" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&display=swap" />
    <mj-attributes>
      <mj-all font-family="Montserrat, Arial, sans-serif" />
      <mj-text font-size="14px" color="#333333" />
      <mj-button background-color="#002D74" color="#ffffff" font-weight="700" border-radius="6px" inner-padding="14px 26px" />
      <mj-image padding="0" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f2f2f2">
    <mj-section background-color="#65B2E8" padding="28px 20px">
      <mj-column>
        <mj-image src="https://res.cloudinary.com/dem8z9lgk/image/upload/v1770168084/vv-white-RGB_quomiu.png" alt="Gara Group" width="140px" padding-bottom="14px" />
        <mj-text align="center" color="#ffffff" font-size="22px" font-weight="700" letter-spacing="0.5px" padding-bottom="6px">
          New Arrivals & Updates
        </mj-text>
        <mj-text align="center" color="#ffffff" font-size="16px" font-weight="600" padding-bottom="4px">
          Explore our latest products and curated collections
        </mj-text>
        <mj-text align="center" color="#ffffff" font-size="13px" font-weight="500">
          February 2, 2026
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="0" background-color="#f2f2f2">
      <mj-column>
        <mj-spacer height="20px" />
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="20px">
      <mj-column width="72px" vertical-align="middle">
        <mj-image src="https://res.cloudinary.com/dem8z9lgk/image/upload/v1770166505/ChatGPT_Image_3_feb_2026_17_54_47_wecgkw.png" alt="Gara Group" width="64px" height="64px" border-radius="32px" />
      </mj-column>
      <mj-column vertical-align="middle">
        <mj-text font-size="13px" font-weight="600" padding="0 0 2px 12px">
          <span style="color:#65B2E8;font-size:18px;font-weight:700;">“</span>
          <span style="color:#6B7280;">
            Quality, design, and performance — thoughtfully crafted for modern lifestyles.
          </span>
          <span style="color:#65B2E8;font-size:18px;font-weight:700;">”</span>
        </mj-text>
        <mj-text color="#6B7280" font-size="11px" font-weight="500" padding="0 0 0 12px">
          — Gara Group
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="0" background-color="#f2f2f2">
      <mj-column>
        <mj-spacer height="16px" />
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="28px 24px">
      <mj-column vertical-align="middle">
        <mj-text font-size="20px" font-weight="700" padding-bottom="8px">
          Amazing products waiting for you
        </mj-text>
        <mj-text font-size="15px" color="#6B7280">
          Discover carefully selected items designed to combine functionality,
          style, and innovation — all in one place.
        </mj-text>
      </mj-column>
      <mj-column width="220px" vertical-align="middle">
        <mj-image src="https://res.cloudinary.com/dem8z9lgk/image/upload/v1770168456/beauty-woman-using-reading-smart-phone-isolated_msgs46.jpg" alt="Featured products" width="200px" border-radius="8px" />
      </mj-column>
    </mj-section>
    <mj-section padding="0" background-color="#f2f2f2">
      <mj-column>
        <mj-spacer height="16px" />
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="32px 24px">
      <mj-column>
        <mj-text font-size="20px" font-weight="700" padding-bottom="12px">
          Welcome
        </mj-text>
        <mj-text font-size="16px">
          We’re pleased to share the latest updates from our store.
          From new product launches to refined collections, explore what’s new
          and find the perfect addition for your everyday needs.
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="0" background-color="#f2f2f2">
      <mj-column>
        <mj-spacer height="20px" />
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="0 24px 32px">
      <mj-column vertical-align="middle">
        <mj-button href="#">
          Visit the Store
        </mj-button>
      </mj-column>
      <mj-column width="150px" vertical-align="middle">
        <mj-image src="https://res.cloudinary.com/dem8z9lgk/image/upload/v1770165308/Macbook_Laptop_Mockup_tdenqa.jpg" alt="Shop online" width="150px" />
      </mj-column>
    </mj-section>
    <mj-section padding="0" background-color="#f2f2f2">
      <mj-column>
        <mj-spacer height="24px" />
      </mj-column>
    </mj-section>
    <mj-section background-color="#65B2E8" padding="18px">
      <mj-column>
        <mj-text color="#ffffff" font-size="12px" align="center">
          © Gara Group · All rights reserved
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>